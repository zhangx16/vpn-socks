+package main
+import ("net";"testing";"strings")
+func TestUnavailableBoundExitIsBlocked(t *testing.T) {
+ for _,status:=range []string{"starting","failed","stopped"} {
+  ib:=&nativeInbound{ID:1,Port:33001,Protocol:"vless",Network:"ws",Enable:true,BoundTo:"vpn-test"}
+  cfg:=buildXrayConfig([]*nativeInbound{ib},[]*Tunnel{{Status:status,Node:Node{HostName:"vpn-test"}}})
+  rules:=cfg["routing"].(map[string]any)["rules"].([]any)
+  if len(rules)!=1 || rules[0].(map[string]any)["outboundTag"]!="block" {t.Fatalf("%s must block: %v",status,rules)}
+ }
+}
+func TestLiveBoundExitKeepsItsRoute(t *testing.T) {
+ ib:=&nativeInbound{ID:1,Port:33001,Protocol:"vless",Network:"ws",Enable:true,BoundTo:"vpn-test"}
+ cfg:=buildXrayConfig([]*nativeInbound{ib},[]*Tunnel{{Status:"up",Node:Node{HostName:"vpn-test"}}})
+ rule:=cfg["routing"].(map[string]any)["rules"].([]any)[0].(map[string]any)
+ if rule["outboundTag"]!=xuiTagPrefix+"vpn-test" {t.Fatal(rule)}
+}
+func TestMissingVPNInterfaceCannotFallBackToLoopback(t *testing.T) {
+ listener,err:=net.Listen("tcp4","127.0.0.1:0");if err!=nil {t.Fatal(err)};defer listener.Close()
+ dialer:=vpnOnlyDialer("fo-no-such-vpn");conn,err:=dialer.Dial("tcp4",listener.Addr().String())
+ if conn!=nil {conn.Close();t.Fatal("VPN-less socket unexpectedly connected")}
+ if err==nil || !strings.Contains(err.Error(),"FANOUT_FAIL_CLOSED_V1") {t.Fatalf("missing interface was not blocked: %v",err)}
+}
