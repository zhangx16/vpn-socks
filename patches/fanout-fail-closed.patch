+// Pin application sockets to the VPN interface; a missing/down VPN must never use the host route.
+func vpnOnlyDialer(device string) net.Dialer {
+ return net.Dialer{Timeout: 15*time.Second, Control: func(network, address string, raw syscall.RawConn) error {
+  var bindErr error
+  if err := raw.Control(func(fd uintptr) { bindErr = unix.SetsockoptString(int(fd), unix.SOL_SOCKET, unix.SO_BINDTODEVICE, device) }); err != nil { return err }
+  if bindErr != nil { return fmt.Errorf("FANOUT_FAIL_CLOSED_V1: bind VPN interface: %w", bindErr) }
+  return nil
+ }}
+}
