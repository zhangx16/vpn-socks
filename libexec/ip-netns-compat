#!/bin/sh
# LXC: enter only the network namespace, avoiding a denied sysfs mount.
if [ "$#" -ge 4 ] && [ "$1" = netns ] && [ "$2" = exec ]; then
    namespace="$3"
    shift 3
    # nsenter preserves the host's resolv.conf. Keep private host DNS reachable
    # after OpenVPN installs its split default routes, without changing host DNS.
    if [ "$1" = openvpn ]; then
        gateway=$(/usr/bin/nsenter --net="/run/netns/$namespace" -- /sbin/ip route show default | awk '/default via/ {print $3; exit}')
        if [ -n "$gateway" ]; then
            for resolver in $(awk '/^nameserver / {split($2,a,"."); if(a[1]==10 || (a[1]==172 && a[2]>=16 && a[2]<=31) || (a[1]==192 && a[2]==168)) print $2}' /etc/resolv.conf); do
                /usr/bin/nsenter --net="/run/netns/$namespace" -- /sbin/ip route replace "$resolver/32" via "$gateway" || exit 1
            done
        fi
    fi
    exec /usr/bin/nsenter --net="/run/netns/$namespace" -- "$@"
fi
exec /sbin/ip "$@"
